{
  "_comment": "All bots use Claude Code CLI backend. claude.system_prompt is required.",
  "bots": {
    "default": {
      "display_name": "MyBot",
      "feishu_profile": "bridge",
      "feishu_app_id": "cli_xxxxxxxxxxxx",
      "feishu_app_secret": "YOUR_FEISHU_APP_SECRET",
      "claude": {
        "system_prompt": "你是一个通过飞书与用户交流的AI助手。回答简洁清晰。"
      },
      "claude_cli": {
        "model": "deepseek-v4-pro[1m]",
        "permission_mode": "auto",
        "allowed_tools": ["Bash", "Edit", "Read", "Write", "Glob", "Grep"],
        "add_dirs": ["C:\\Users\\yourname\\Desktop"],
        "max_turns": 20,
        "timeout_seconds": 120,
        "reaction_emoji": "Typing"
      },
      "max_context_messages": 20
    }
  }
}
